# Flutter OTA Updater Environment Variables (VPS / Production)
HTTP_PORT=80
DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_HOSTS=*
# CSRF Origins for domain/IP access (comma-separated, e.g. https://ota.mydomain.com,http://185.120.x.x)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL Database Configuration
POSTGRES_DB=flutter_ota_db
POSTGRES_USER=ota_user
POSTGRES_PASSWORD=ota_secret_123
